{
  "permissions": {
    "deny": [
      "command(regex:.*\\bgit\\s+push\\b.*)",
      "command(regex:.*\\bgit\\s+(remote|config)\\b.*)",
      "command(regex:.*\\bgh\\s+(pr|release|repo|secret|api)\\b.*)",
      "command(regex:.*\\b(npm|pnpm|yarn)\\s+publish\\b.*)",
      "command(regex:.*\\b(vercel|netlify|wrangler|flyctl|kubectl|terraform)\\b.*)",
      "command(regex:.*\\bcurl\\b.*-X\\s*(POST|PUT|DELETE|PATCH)\\b.*)",
      "command(regex:.*\\bsudo\\b.*)",
      "command(regex:.*\\brm\\s+-(rf|fr)\\s+/(\\s.*)?$)",
      "command(regex:.*\\.secrets\\b.*)",
      "read_file(.env)",
      "read_file(/home/USER/.secrets)"
    ]
  }
}
