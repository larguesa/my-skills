{
  "permission": {
    "bash": {
      "*git push*": "deny",
      "*git -C * push*": "deny",
      "*git -c * push*": "deny",
      "*git --git-dir* push*": "deny",
      "*git --work-tree* push*": "deny",
      "*git --no-pager *push*": "deny",
      "*git remote*": "deny",
      "*git config*": "deny",
      "*curl *-X POST*": "deny",
      "*curl *-XPOST*": "deny",
      "*curl *-X PUT*": "deny",
      "*curl *-XPUT*": "deny",
      "*curl *-X DELETE*": "deny",
      "*curl *-XDELETE*": "deny",
      "*curl *-X PATCH*": "deny",
      "*curl *-XPATCH*": "deny",
      "*curl *--request POST*": "deny",
      "*curl *--request=POST*": "deny",
      "*curl *--request PUT*": "deny",
      "*curl *--request=PUT*": "deny",
      "*curl *--request DELETE*": "deny",
      "*curl *--request=DELETE*": "deny",
      "*curl *--request PATCH*": "deny",
      "*curl *--request=PATCH*": "deny",
      "*curl *-d *": "deny",
      "*curl *--data*": "deny",
      "*curl *--json*": "deny",
      "*curl *-F *": "deny",
      "*curl *--form*": "deny",
      "*curl *-T *": "deny",
      "*curl *--upload-file*": "deny",
      "*npm *publish*": "deny",
      "*pnpm *publish*": "deny",
      "*yarn *publish*": "deny",
      "*cargo *publish*": "deny",
      "*uv *publish*": "deny",
      "*twine upload*": "deny",
      "*gh pr create*": "deny",
      "*gh pr merge*": "deny",
      "*gh pr close*": "deny",
      "*gh pr edit*": "deny",
      "*gh pr comment*": "deny",
      "*gh release *": "deny",
      "*gh repo create*": "deny",
      "*gh repo delete*": "deny",
      "*gh api *": "deny",
      "*gh secret *": "deny",
      "*vercel *": "deny",
      "*netlify *": "deny",
      "*wrangler *": "deny",
      "*flyctl *": "deny",
      "*kubectl *": "deny",
      "*terraform *": "deny",
      "*sudo *": "deny",
      "rm -rf /": "deny",
      "rm -fr /": "deny",
      "rm -rf /*": "deny",
      "rm -fr /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      "rm -rf $HOME": "deny",
      "rm -rf $HOME/*": "deny",
      "*.secrets*": "deny"
    },
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*/.secrets/*": "deny",
      "*.secrets": "deny",
      "*auth.json": "deny",
      "*.credentials.json": "deny",
      "*/.ssh/*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*/.secrets/*": "deny",
      "*.secrets": "deny",
      "*auth.json": "deny",
      "*.credentials.json": "deny",
      "*/.ssh/*": "deny",
      "*.env.example": "allow"
    }
  }
}
