# Auto detect text files and perform LF normalization
* text=auto
# Telegraphist tests compare SKILL.md byte for byte.
skills/telegraphist/** text eol=lf
# Keep frozen skill/test hashes valid on Windows checkouts.
skills/humanizador-pt-br/** text eol=lf
# Preserve exact bytes of the sampled comparison and its frozen inputs.
skills/humanizador-pt-br/results/samples/2026-10-25/** -text
# Audited generated reports retain their renderer's final blank paragraph.
skills/humanizador-pt-br/results/samples/2026-10-25/report/REPORT.md whitespace=-blank-at-eof
skills/humanizador-pt-br/results/samples/2026-10-25/report/cases/*.md whitespace=-blank-at-eof
